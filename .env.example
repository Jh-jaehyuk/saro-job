# ============================================================
# saro-job — Example environment variables
# ============================================================
# 실제 값은 .env(gitignored)에 두거나 운영은 `fly secrets set`을 사용한다.
# `app/core/config.py`의 Settings(BaseSettings)가 이 변수들을 읽는다.
# 새 변수를 추가하면 이 파일과 Settings 양쪽 모두 갱신한다.
# ============================================================

# --- Database (Postgres + pgvector) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sarojob

# --- Redis (ARQ queue + Pub/Sub fan-out) ---
# 호스트 포트는 docker-compose에서 6380으로 매핑(6379는 일반적으로 다른 로컬 redis가
# 점유 중인 경우가 많음). 컨테이너 내부 포트는 표준 6379.
REDIS_URL=redis://localhost:6380/0

# --- Object Storage (S3 호환: 운영 R2 / 로컬 MinIO) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=sarojob-local

# --- 환경 식별자 ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Auth (fastapi-users) ---
# auth_secret_key: JWT 서명 키. 운영에선 `openssl rand -hex 32`로 생성하여 fly secrets에 저장.
AUTH_SECRET_KEY=change-me-in-prod-this-is-a-development-only-default
# 쿠키 Secure 속성. 로컬은 http이므로 false, 운영은 true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_MAX_AGE=604800

# --- Google OAuth ---
# Google Cloud Console > APIs & Services > Credentials 에서 OAuth 2.0 Client ID 발급.
# 콜백 URL은 콘솔의 "Authorized redirect URIs"에도 동일하게 등록되어야 함.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8000/auth/google/callback

# --- LLM (OpenAI) ---
# 비어 있으면 워커는 placeholder LLM으로 동작(analyzed 단계에서 실패).
OPENAI_API_KEY=
# 모델을 바꾸면 apps/api/app/services/llm.py의 가격표에도 추가해야 한다.
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_MAX_INPUT_CHARS=12000
LLM_MAX_OUTPUT_TOKENS=1024
# 조직별 하루(UTC) LLM 비용 한도(USD). 0이면 한도 없음.
LLM_DAILY_BUDGET_USD_PER_ORG=1.00
